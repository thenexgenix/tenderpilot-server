generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenderStatus {
  DRAFT
  PROCESSING
  ANALYZED
  ATTENTION_REQUIRED
  PROCESSING_FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  tenders          Tender[]
  aiAnalysisUsages AiAnalysisUsage[]
}

model Tender {
  id         String    @id @default(cuid())
  ownerId    String
  title      String
  issuerName String
  reference  String?
  deadlineAt DateTime?
  notes      String?

  fileStorageKey   String?   @unique
  fileOriginalName String?
  fileMimeType     String?
  fileSizeBytes    Int?
  fileSha256       String?
  fileUploadedAt   DateTime?

  status    TenderStatus @default(DRAFT)
  stage     String?
  errorCode String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  pages        DocumentPage[]
  requirements Requirement[]

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([ownerId, fileSha256])
}

model DocumentPage {
  id               String   @id @default(cuid())
  tenderId         String
  pageNumber       Int
  text             String   @db.Text
  characterCount   Int      @default(0)
  hasText          Boolean  @default(false)
  extractionStatus String   @default("PENDING")
  errorCode        String?
  createdAt        DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, pageNumber])
  @@index([tenderId])
}

model Requirement {
  id           String   @id @default(cuid())
  tenderId     String
  displayId    String
  category     String
  text         String   @db.Text
  explanation  String?  @db.Text
  obligation   String
  pageNumber   Int?
  quote        String?  @db.Text
  verification String   @default("UNVERIFIED")
  origin       String   @default("AI")
  checkStatus  String   @default("NOT_REVIEWED")
  checkNote    String?  @db.Text
  updatedAt    DateTime @updatedAt

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, displayId])
  @@index([tenderId])
}

model AiAnalysisUsage {
  id            String   @id @default(cuid())
  userId        String
  usageDate     String
  analysisCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, usageDate])
  @@index([userId])
}
