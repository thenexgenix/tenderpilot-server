generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenderStatus {
  DRAFT
  PROCESSING
  ANALYZED
  ATTENTION_REQUIRED
  PROCESSING_FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  tenders Tender[]
}

model Tender {
  id         String    @id @default(cuid())
  ownerId    String
  title      String
  issuerName String
  reference  String?
  deadlineAt DateTime?
  notes      String?

  fileStorageKey   String?   @unique
  fileOriginalName String?
  fileMimeType     String?
  fileSizeBytes    Int?
  fileSha256       String?
  fileUploadedAt   DateTime?

  status    TenderStatus @default(DRAFT)
  stage     String?
  errorCode String?
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  pages DocumentPage[]

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([ownerId, fileSha256])
}

model DocumentPage {
  id               String   @id @default(cuid())
  tenderId         String
  pageNumber       Int
  text             String   @db.Text
  characterCount   Int      @default(0)
  hasText          Boolean  @default(false)
  extractionStatus String   @default("PENDING")
  errorCode        String?
  createdAt        DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, pageNumber])
  @@index([tenderId])
}
